{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "para",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // Your built static site. Next.js static export goes to ./out
  // (next.config: output: 'export'). The Worker handles /api/* and falls
  // through to these assets for everything else.
  //
  // run_worker_first: without it, requests matching a static asset are served
  // by the asset layer WITHOUT invoking the Worker — so withSecurityHeaders()
  // (CSP/HSTS/XFO) and the /opengraph-image content-type fix silently never
  // applied to pages in production. Worker-first costs one invocation per
  // asset request and buys correct headers on every response.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "para-orders",
      "database_id": "a7359ef3-8ed0-4876-9a23-db650cecc9f6"
    }
  ],

  // Non-secret config. Secrets are set separately (see .dev.vars.example / README).
  "vars": {
    "PUBLIC_BASE_URL": "https://para.rs",
    "RECEIPT_FROM": "PARA <racun@para.rs>",
    "ALLSECURE_SIGN_OUTGOING": "false"
  }
}
